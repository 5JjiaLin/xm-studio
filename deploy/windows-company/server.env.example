# Copy to D:/XMStudio/config/server.env; replace the password before starting.
AUTH_ENABLED=true
AUTH_USERNAME=xm-team
AUTH_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
AUTH_TOKEN_SECRET=
ARCREEL_DATA_DIR=D:/XMStudio/data
DATABASE_URL=sqlite+aiosqlite:///D:/XMStudio/data/arcreel.db
ARCREEL_PROFILE_DIR=D:/XMStudio/profile/agent
CLAUDE_CONFIG_DIR=D:/XMStudio/profile/claude
ARCREEL_API_BASE=http://127.0.0.1:1242/api/v1
CORS_ORIGINS=https://xm.internal
LOG_LEVEL=INFO
PYTHONUTF8=1

# The company launcher enforces these paths and disables source-tree .env loading.
# Provider credentials are managed by the application's existing configuration UI.
